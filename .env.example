DOCKER_CONTEXT=hpz440
COMPOSE_PROJECT_NAME=hpz440-llm

HOST_MODEL_DIR=/srv/llm/models
LLM_MODEL_PATH=/models/model.gguf
LLM_CONTEXT_SIZE=8192
LLM_GPU_LAYERS=999
# Concurrent llama.cpp slots. LLM_CONTEXT_SIZE is the TOTAL KV budget and is divided
# across slots: LLM_PARALLEL=4 with LLM_CONTEXT_SIZE=8192 gives each slot 2048 tokens.
# Raise only for a benchmark sweep; scripts/stress-test.ps1 sets and restores it.
LLM_PARALLEL=1
LLM_HOST_PORT=8080

WEBUI_HOST_PORT=3000
WEBUI_SECRET_KEY=change-me-before-use

# Jarvis (Phases 1 and 1.5). HOST_JARVIS_DATA_DIR is mounted at /data in the jarvis container.
HOST_JARVIS_DATA_DIR=/srv/llm/jarvis-data
JARVIS_HOST_PORT=8090
JARVIS_GMAIL_ACCOUNT=conradstorz@gmail.com
JARVIS_GMAIL_QUERY=in:inbox
JARVIS_MAX_MESSAGES_PER_RUN=50

# GTE workspace agent on the workstation, reachable from the HPZ440 (tailnet address). Empty disables document tools.
JARVIS_WORKSPACE_AGENT_URL=
# Workstation document reads: skip files above this size; read at most this many PDF pages.
JARVIS_MAX_DOCUMENT_BYTES=5000000
JARVIS_MAX_PDF_PAGES=20
