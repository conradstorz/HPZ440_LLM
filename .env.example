DOCKER_CONTEXT=hpz440
COMPOSE_PROJECT_NAME=hpz440-llm

HOST_MODEL_DIR=/srv/llm/models
# Model id Jarvis (JARVIS_LLM_MODEL) and scripts/benchmark.ps1 request from llm-api. llama-swap rejects
# unknown ids, so this must be an id or alias in llama-swap/config.yaml (scripts/switch-model.ps1 checks).
LLM_MODEL_PATH=/models/Qwen2.5-7B-Instruct-Q4_K_M.gguf
# Feeds JARVIS_CONTEXT_TOKENS only. The server's context is the `ctx` macro in llama-swap/config.yaml;
# keep the two equal (tests/assert-project-shape.ps1 checks).
LLM_CONTEXT_SIZE=8192
LLM_HOST_PORT=8080

WEBUI_HOST_PORT=3000
WEBUI_SECRET_KEY=change-me-before-use

# Jarvis (Phases 1 and 1.5). HOST_JARVIS_DATA_DIR is mounted at /data in the jarvis container.
HOST_JARVIS_DATA_DIR=/srv/llm/jarvis-data
JARVIS_HOST_PORT=8090
JARVIS_GMAIL_ACCOUNT=conradstorz@gmail.com
#   The query's own time filter, not the watermark, decides the window: a `newer_than:` clause is tighter than
#   the `after:` the poller derives from the last run, so it wins. That makes the cap below load-bearing -- if a
#   day's mail exceeds it, every run caps, the leftovers age out of `newer_than:1d`, and they are never triaged.
#   Keep the cap at roughly twice the daily volume this query matches. `category:primary` is what makes 50 safe
#   here: the full inbox takes ~170/day, primary ~12. Widen the query and raise the cap together, never alone.
JARVIS_GMAIL_QUERY=in:inbox newer_than:1d category:primary
JARVIS_MAX_MESSAGES_PER_RUN=50

# GTE workspace agent on the workstation, reachable from the HPZ440 (tailnet address). Empty disables document tools.
JARVIS_WORKSPACE_AGENT_URL=
# Workstation document reads: skip files above this size; read at most this many PDF pages.
JARVIS_MAX_DOCUMENT_BYTES=5000000
JARVIS_MAX_PDF_PAGES=20

# Obi-Wan (the Historian). HOST_OBIWAN_DIR on the HPZ440 holds data/ (record and index), inbox/ (the writable worklist)
# and corpus/ (the first source root, mounted read-only). Create the three directories once: see docs/obiwan.md.
HOST_OBIWAN_DIR=/srv/obiwan
# Three distinct credentials. Jarvis receives reader and writer; the commander token goes only to the obiwan container
# and stays with you. Generate each with: [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
OBIWAN_READER_TOKEN=change-me-reader
OBIWAN_WRITER_TOKEN=change-me-writer
OBIWAN_COMMANDER_TOKEN=change-me-commander
